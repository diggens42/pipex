FROM debian:bookworm-slim

RUN apt-get update \
	&& apt-get install -y --no-install-recommends \
		build-essential make git ca-certificates \
		bash coreutils diffutils valgrind \
		python3 python3-pip curl vim less procps \
	&& rm -rf /var/lib/apt/lists/*

RUN pip3 install --break-system-packages --no-cache-dir norminette

# 42 evaluations run as a normal user; running as root would mask
# every permission-related test (chmod 000 does not stop root).
RUN useradd -m -u 1000 -s /bin/bash tester
USER tester

WORKDIR /pipex

CMD ["/bin/bash"]
